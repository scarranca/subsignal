# ===========================================
# Subsignal CRM - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Environment
# -------------------------------------------
NODE_ENV=development

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/subsignal

# -------------------------------------------
# Authentication (Better Auth)
# -------------------------------------------
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_COOKIE_PREFIX=subsignal

# Public auth URL (for client-side)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# -------------------------------------------
# Google OAuth (Gmail & Calendar Sync)
# -------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Required scopes: gmail.readonly, gmail.send, gmail.modify, calendar.readonly, calendar.events
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------
# Email Service (Resend)
# -------------------------------------------
# Get your API key at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_EMAIL_SENDER=onboarding@resend.dev
RESEND_SENDER_NAME=Subsignal

# -------------------------------------------
# Cloudflare R2 Storage (Snapshots)
# -------------------------------------------
# For storing screenshots and HTML snapshots
SNAPSHOT_R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
SNAPSHOT_R2_ACCESS_KEY_ID=your-r2-access-key-id
SNAPSHOT_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
SNAPSHOT_R2_BUCKET_NAME=snapshots
SNAPSHOT_BUCKET_BASE=https://snapshots.yourdomain.com

# -------------------------------------------
# Cloudflare R2 Storage (Briefings)
# -------------------------------------------
# Optional: Uses snapshot R2 values as fallback if not set
BRIEFING_R2_ENDPOINT=
BRIEFING_R2_ACCESS_KEY_ID=
BRIEFING_R2_SECRET_ACCESS_KEY=
BRIEFING_R2_BUCKET_NAME=
BRIEFING_BUCKET_BASE=

# -------------------------------------------
# Screenshot Service
# -------------------------------------------
SCREENSHOT_API_KEY=your-screenshot-api-key
SCREENSHOT_API_ORIGIN=https://api.screenshot-service.com

# -------------------------------------------
# Payment Processing (DodoPayments)
# -------------------------------------------
# Get your keys at: https://dodopayments.com
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-signing-key

# Product IDs for subscription plans
NEXT_PUBLIC_DODO_SOLO_PRODUCT_ID_MONTHLY=pdt_solo_monthly
NEXT_PUBLIC_DODO_SOLO_PRODUCT_ID_ANNUALLY=pdt_solo_annually
NEXT_PUBLIC_DODO_TEAM_PRODUCT_ID_MONTHLY=pdt_team_monthly
NEXT_PUBLIC_DODO_TEAM_PRODUCT_ID_ANNUALLY=pdt_team_annually

# -------------------------------------------
# Public URLs (Client-Side)
# -------------------------------------------
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
